# Secrets and generated state — never commit
.env
synapse/
whatsapp/
meta/
gmessages/
linkedin/
twitter/
element/config.json
*.backup
*.bak
pg_dump*
# imessage bridge: track the source (daemon.py, Package.resolved.pinned,
# daemon.json.example); ignore secrets, runtime state, build output, and the
# external platform-imessage clone.
imessage/daemon.json
imessage/*.db
imessage/logs/
imessage/tmp/
imessage/bin/
imessage/platform-imessage/

# Harness state and worktrees
.claude/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Master (matrix-master) secrets and generated state — never commit
master/synapse/
master/tokens.local
master/.env
master/.provision-state.local
master/enrollments.local

# Master enroll/admin service logs (launchd) — never commit
master/logs/*.log
master/logs/*.err

# Uplink enrollment credentials written on the teammate side — never commit
uplink.env.local
*.uplink.env.local

# Uplink daemon logs (launchd) — never commit
agents/uplink/logs/

# Google Messages connect helper logs (launchd) — never commit (may transit
# no secrets by design, but keep runtime logs out of git regardless)
gmessages-connect/logs/

# IG/LI/X connect helper logs (launchd) — never commit
session-connect/logs/
