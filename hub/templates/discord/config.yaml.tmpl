homeserver:
    address: http://synapse:8008
    domain: localhost
    software: standard
appservice:
    address: http://mautrix-discord:29334
    hostname: 0.0.0.0
    port: 29334
    database:
        type: postgres
        uri: postgres://matrix:${DB_PASSWORD}@postgres/mautrix_discord?sslmode=disable
        max_open_conns: 10
        max_idle_conns: 2
    id: discord
    bot:
        username: discordbot
        displayname: Discord bridge
        avatar: ""
    ephemeral_events: true
    async_transactions: false
    as_token: "${AS_TOKEN_DISCORD}"
    hs_token: "${HS_TOKEN_DISCORD}"
bridge:
    username_template: discord_{{.}}
    displayname_template: '{{or .GlobalName .Username}}'
    channel_name_template: '{{.Name}}'
    guild_name_template: '{{.Name}}'
    private_chat_portal_meta: always
    portal_message_buffer: 128
    startup_private_channel_create_limit: 25
    delivery_receipts: true
    message_status_events: true
    message_error_notices: true
    restricted_rooms: false
    autojoin_thread_on_open: false
    sync_direct_chat_list: true
    delete_portal_on_channel_delete: false
    delete_guild_on_leave: false
    federate_rooms: false
    forbid_dming_strangers: true
    use_discord_cdn_upload: true
    direct_media:
        enabled: false
    double_puppet_server_map:
        localhost: http://synapse:8008
    double_puppet_allow_discovery: false
    login_shared_secret_map:
        localhost: as_token:${AS_TOKEN_DISCORD}
    command_prefix: '!discord'
    backfill:
        forward_limits:
            initial:
                dm: 100
                channel: 0
                thread: 0
            missed:
                dm: 500
                channel: 0
                thread: 0
        max_guild_members: 0
    encryption:
        allow: false
        default: false
        require: false
    provisioning:
        prefix: /_matrix/provision
        shared_secret: ${PROV_DISCORD}
        debug_endpoints: false
    permissions:
        "${LOCAL_MXID}": user
logging:
    min_level: info
    writers:
        - type: stdout
          format: json
