# Configuration file for Synapse.
#
# This is a YAML file: see [1] for a quick introduction. Note in particular
# that *indentation is important*: all the elements of a list or dictionary
# should have the same indentation.
#
# [1] https://docs.ansible.com/ansible/latest/reference_appendices/YAMLSyntax.html
#
# For more information on how to configure Synapse, including a complete accounting of
# each option, go to docs/usage/configuration/config_documentation.md or
# https://element-hq.github.io/synapse/latest/usage/configuration/config_documentation.html
server_name: "localhost"
pid_file: /data/homeserver.pid
listeners:
  - port: 8008
    resources:
    - compress: false
      names:
      - client
      - federation
    tls: false
    type: http
    x_forwarded: true
database:
  name: psycopg2
  args:
    user: matrix
    password: "${DB_PASSWORD}"
    dbname: synapse
    host: postgres
    port: 5432
    cp_min: 5
    cp_max: 10
log_config: "/data/localhost.log.config"
media_store_path: /data/media_store
report_stats: false
macaroon_secret_key: "${MACAROON_SECRET}"
form_secret: "${FORM_SECRET}"
signing_key_path: "/data/localhost.signing.key"
trusted_key_servers: []

enable_registration: false


# vim:ft=yaml
app_service_config_files:
  - /data/registration.yaml
  - /data/imessage-registration.yaml
  - /data/meta-registration.yaml
  - /data/gmessages-registration.yaml
  - /data/linkedin-registration.yaml
  - /data/twitter-registration.yaml

rc_login:
  address:
    per_second: 0.15
    burst_count: 10
  account:
    per_second: 0.15
    burst_count: 10
  failed_attempts:
    per_second: 0.15
    burst_count: 10

rc_joins:
  local:
    per_second: 20
    burst_count: 300

# The uplink daemon does a bounded full initial /sync every reconcile pass
# (~30s) by design; Synapse's initial-sync response cache (default 2m) fed it
# minutes-stale consent/room state (found live 2026-08-29). Single-user
# server: fresh computation is cheap.
caches:
  sync_response_cache_duration: 0
